# Copy this file to docker/jellyfin/.env and edit only the host paths/ports you need.
# Use forward slashes on Windows paths (for example D:/Movies).

TZ=America/Sao_Paulo
PUID=1000
PGID=1000

# Jellyfin
JELLYFIN_IMAGE=jellyfin/jellyfin:latest
JELLYFIN_HTTP_PORT=8096
JELLYFIN_DISCOVERY_PORT=7359

# ARR / request stack
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:latest
RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:latest
SEERR_IMAGE=ghcr.io/seerr-team/seerr:latest

QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
SEERR_PORT=5055
SEERR_LOG_LEVEL=info

# Windows examples:
# JELLYFIN_MOVIES_PATH=D:/Movies
# JELLYFIN_SERIES_PATH=D:/Series
# JELLYFIN_MUSIC_PATH=D:/Music
# JELLYFIN_OTHER_MEDIA_PATH=D:/Other
# DOWNLOADS_PATH=D:/Downloads

# Linux/macOS examples:
# JELLYFIN_MOVIES_PATH=/mnt/media/movies
# JELLYFIN_SERIES_PATH=/mnt/media/series
# JELLYFIN_MUSIC_PATH=/mnt/media/music
# JELLYFIN_OTHER_MEDIA_PATH=/mnt/media/other
# DOWNLOADS_PATH=/mnt/media/downloads

# Safe local defaults. Docker will create these under docker/jellyfin/runtime
# if you do not replace them with real host paths.
JELLYFIN_MOVIES_PATH=./runtime/media/movies
JELLYFIN_SERIES_PATH=./runtime/media/series
JELLYFIN_MUSIC_PATH=./runtime/media/music
JELLYFIN_OTHER_MEDIA_PATH=./runtime/media/other
DOWNLOADS_PATH=./runtime/downloads
